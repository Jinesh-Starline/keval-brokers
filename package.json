{
  "name": "keval-brokers",
  "version": "0.2.0",
  "private": true,
  "description": "Daily deal register, WhatsApp confirmations and brokerage billing for Keval Brokers",
  "author": "Keval Brokers",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:pwa": "node scripts/build-pwa.js",
    "deploy:pwa": "node scripts/build-pwa.js && npx netlify-cli deploy --prod --dir=pwa",
    "test": "node test/logic.test.js && node test/sync.test.js && node test/smoke.test.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac --x64",
    "dist:mac:arm": "electron-builder --mac --arm64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^25.0.1"
  },
  "build": {
    "appId": "com.kevalbrokers.app",
    "productName": "Keval Brokers",
    "compression": "maximum",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/AppIcon.ico",
      "uninstallerIcon": "build/AppIcon.ico",
      "installerHeaderIcon": "build/AppIcon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Keval Brokers",
      "uninstallDisplayName": "Keval Brokers",
      "runAfterFinish": true,
      "menuCategory": "Keval Brokers",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Keval Brokers Setup ${version}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/AppIcon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business",
      "icon": "build/AppIcon.icns",
      "artifactName": "Keval Brokers ${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    }
  }
}
