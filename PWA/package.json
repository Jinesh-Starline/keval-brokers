{
  "name": "keval-brokers",
  "version": "0.1.0",
  "description": "Daily deal register, WhatsApp confirmations and brokerage billing for Keval Brokers",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:pwa": "node scripts/build-pwa.js",
    "test": "node test/logic.test.js && node test/sync.test.js && node test/smoke.test.js",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^25.0.1"
  },
  "build": {
    "appId": "com.kevalbrokers.app",
    "productName": "Keval Brokers",
    "files": ["main.js", "preload.js", "renderer/**/*", "package.json"],
    "win": { "target": "nsis" }
  }
}
